{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/ALENZACODES/alef-tools/blob/main/models.manifest.schema.json",
 "title": "alef-tools models manifest",
 "type": "object",
 "required": ["schema", "contract", "checked", "packHost", "packs", "models"],
 "additionalProperties": false,
 "properties": {
  "schema": { "const": "alef.models.manifest.v1" },
  "contract": { "const": 1 },
  "checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
  "note": { "type": "string" },
  "packHost": { "type": "string", "pattern": "^https://.+/$" },
  "talkRuntime": { "type": "object" },
  "packs": {
   "type": "object",
   "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
   "additionalProperties": {
    "type": "object",
    "required": ["title", "what", "budgetBytes", "device", "published", "cache", "format", "lane"],
    "additionalProperties": false,
    "properties": {
     "title": { "type": "string", "minLength": 3, "maxLength": 40 },
     "what": { "type": "string", "minLength": 10, "maxLength": 140 },
     "budgetBytes": { "type": "integer", "minimum": 1 },
     "budgetNote": { "type": "string" },
     "device": { "$ref": "#/$defs/device" },
     "deviceNote": { "type": "string" },
     "published": { "type": "boolean" },
     "cache": { "type": "string", "pattern": "^alef-(pack-[a-z0-9-]+|talk-pack)-v1$" },
     "format": { "enum": ["alef.pack.v1", "alef.talk.nmt.manifest.v1"] },
     "legacy": { "type": "object" },
     "lane": { "type": "integer", "minimum": 1, "maximum": 7 }
    }
   }
  },
  "models": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "hubRevision", "licence", "licenceUrl", "tier", "reason", "pack", "files", "budgetBytes", "device", "attribution"],
    "additionalProperties": false,
    "properties": {
     "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
     "source": { "enum": ["hub", "github", "own", "other"] },
     "sourceUrl": { "type": "string", "pattern": "^https://" },
     "hubRevision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
     "licence": { "type": "string", "minLength": 2 },
     "licenceUrl": { "type": "string", "pattern": "^https://" },
     "tier": { "enum": ["D", "B", "Q", "X"] },
     "reason": { "type": "string", "minLength": 10 },
     "pack": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*$" },
     "files": {
      "type": "array",
      "items": {
       "type": "object",
       "required": ["name", "bytes", "sha256", "url"],
       "additionalProperties": false,
       "properties": {
        "name": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "url": { "type": "string", "pattern": "^https://" }
       }
      }
     },
     "budgetBytes": { "type": "integer", "minimum": 0 },
     "device": { "$ref": "#/$defs/device" },
     "attribution": { "type": "string" }
    }
   }
  }
 },
 "$defs": {
  "device": {
   "type": "object",
   "required": ["webgpu", "minRamGB"],
   "additionalProperties": false,
   "properties": { "webgpu": { "type": "boolean" }, "minRamGB": { "type": "number", "minimum": 0, "maximum": 64 } }
  }
 }
}
