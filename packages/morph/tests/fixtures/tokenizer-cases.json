"text":"בְּבַקָּשָׁה, פֹּה. הִנֵּה הַתַּפְרִיט.","ids":[1,6270,45,2614,47,2451,18337,47,2],"offsets":[[0,0],[0,12],[12,13],[14,18],[18,19],[20,26],[27,38],[38,39],[0,0]]},{"text":"אֲנִי רוֹצֶה שְׁנִיצֶל וְסָלָט.","ids":[1,1482,2193,30962,58008,47,2],"offsets":[[0,0],[0,5],[6,12],[13,22],[23,30],[30,31],[0,0]]},{"text":"וְלִשְׁתּוֹת?","ids":[1,38945,64,2],"offsets":[[0,0],[0,12],[12,13],[0,0]]},{"text":"מַיִם, בְּבַקָּשָׁה.","ids":[1,2902,45,6270,47,2],"offsets":[[0,0],[0,5],[5,6],[7,19],[19,20],[0,0]]},{"text":"סְלִיחָה, אֶפְשָׁר אֶת הַחֶשְׁבּוֹן?","ids":[1,13460,45,1720,1292,9793,64,2],"offsets":[[0,0],[0,8],[8,9],[10,18],[19,22],[23,35],[35,36],[0,0]]},{"text":"בֶּטַח, רֶגַע.","ids":[1,6200,45,3549,47,2],"offsets":[[0,0],[0,6],[6,7],[8,13],[13,14],[0,0]]},{"text":"סְלִיחָה, אֵיפֹה הַתַּחֲנָה הַמֶּרְכָּזִית?","ids":[1,13460,45,4909,11109,5885,64,2],"offsets":[[0,0],[0,8],[8,9],[10,16],[17,27],[28,42],[42,43],[0,0]]},{"text":"לֵךְ יָשָׁר, וְאַחַר כָּךְ פְּנֵה שְׂמֹאלָה.","ids":[1,2089,5696,45,4883,1517,6916,14767,47,2],"offsets":[[0,0],[0,3],[5,11],[11,12],[13,20],[21,25],[27,33],[34,43],[43,44],[0,0]]},{"text":"זֶה רָחוֹק?","ids":[1,1363,5517,64,2],"offsets":[[0,0],[0,3],[4,10],[10,11],[0,0]]},{"text":"לֹא, חָמֵשׁ דַּקּוֹת.","ids":[1,1302,45,4158,2736,47,2],"offsets":[[0,0],[0,3],[3,4],[5,10],[12,20],[20,21],[0,0]]},{"text":"תּוֹדָה רַבָּה!","ids":[1,4558,2910,34,2],"offsets":[[0,0],[0,7],[8,14],[14,15],[0,0]]},{"text":"בְּבַקָּשָׁה.","ids":[1,6270,47,2],"offsets":[[0,0],[0,12],[12,13],[0,0]]},{"text":"הַיי, מָה נִשְׁמָע?","ids":[1,6154,45,1338,5566,64,2],"offsets":[[0,0],[0,4],[4,5],[6,9],[10,18],[18,19],[0,0]]},{"text":"הַכֹּל בְּסֵדֶר, תּוֹדָה. וְאַתָּה?","ids":[1,1714,4273,45,4558,47,7616,64,2],"offsets":[[0,0],[0,6],[7,15],[15,16],[17,24],[24,25],[26,34],[34,35],[0,0]]},{"text":"הַכֹּל טוֹב. מֵאֵיפֹה אַתְּ?","ids":[1,1714,1741,47,13662,1292,64,2],"offsets":[[0,0],[0,6],[7,11],[11,12],[13,21],[22,25],[27,28],[0,0]]},{"text":"אֲנִי מִתֵּל אָבִיב. וְאַתָּה?","ids":[1,1482,12250,2102,47,7616,64,2],"offsets":[[0,0],[0,5],[6,12],[13,19],[19,20],[21,29],[29,30],[0,0]]},{"text":"אֲנִי מִקָּנָדָה. אֲנִי מְדַבֵּר עִבְרִית קְצָת.","ids":[1,1482,58535,47,1482,4395,8927,2525,47,2],"offsets":[[0,0],[0,5],[6,16],[16,17],[18,23],[24,32],[33,41],[42,47],[47,48],[0,0]]},{"text":"מְצֻיָּן! אַתָּה מְדַבֵּר טוֹב.","ids":[1,25650,852,34,1907,4395,1741,47,2],"offsets":[[0,0],[0,5],[7,8],[8,9],[10,16],[17,25],[26,30],[30,31],[0,0]]},{"text":"נָעִים מְאוֹד.","ids":[1,5553,1667,47,2],"offsets":[[0,0],[0,6],[7,13],[13,14],[0,0]]},{"text":"שָׁלוֹם. אֲנִי יָכוֹל לַעֲזֹר?","ids":[1,3387,47,1482,1525,40069,64,2],"offsets":[[0,0],[0,7],[7,8],[9,14],[15,21],[22,29],[29,30],[0,0]]},{"text":"כַּמָּה הַחֻלְצָה הַזֹּאת?","ids":[1,1711,2103,1625,2609,64,2],"offsets":[[0,0],[0,7],[8,13],[14,17],[18,25],[25,26],[0,0]]},{"text":"מֵאָה וַעֲשָׂרָה שְׁקָלִים.","ids":[1,6745,54640,3053,47,2],"offsets":[[0,0],[0,5],[6,16],[17,26],[26,27],[0,0]]},{"text":"יֵשׁ מִדָּה קְטַנָּה?","ids":[1,1408,4329,3913,64,2],"offsets":[[0,0],[0,3],[5,11],[12,20],[20,21],[0,0]]},{"text":"כֵּן, רֶגַע. הִנֵּה.","ids":[1,1745,45,3549,47,2451,47,2],"offsets":[[0,0],[0,4],[4,5],[6,11],[11,12],[13,19],[19,20],[0,0]]},{"text":"אֶפְשָׁר לִמְדֹּד?","ids":[1,1720,22526,64,2],"offsets":[[0,0],[0,8],[9,17],[17,18],[0,0]]},{"text":"בֶּטַח. חֲדַר הַלְבָּשָׁה שָׁם.","ids":[1,6200,47,3759,28438,1715,47,2],"offsets":[[0,0],[0,6],[6,7],[8,13],[14,25],[26,30],[30,31],[0,0]]},{"text":"אֲנִי לוֹקַחַת אֶת זֶה. בְּכַרְטִיס, בְּבַקָּשָׁה.","ids":[1,1482,13488,1292,1363,47,19662,45,6270,47,2],"offsets":[[0,0],[0,5],[6,14],[15,18],[19,22],[22,23],[24,35],[35,36],[37,49],[49,50],[0,0]]},{"text":"שָׁלוֹם. לִשְׂדֵה הַתְּעוּפָה, בְּבַקָּשָׁה.","ids":[1,3387,47,16188,4969,45,6270,47,2],"offsets":[[0,0],[0,7],[7,8],[9,17],[18,29],[29,30],[31,43],[43,44],[0,0]]},{"text":"בְּסֵדֶר. עֲלֵה.","ids":[1,4273,47,3562,47,2],"offsets":[[0,0],[0,8],[8,9],[10,15],[15,16],[0,0]]},{"text":"עִם מוֹנֶה, בְּבַקָּשָׁה.","ids":[1,1364,6029,45,6270,47,2],"offsets":[[0,0],[0,3],[4,10],[10,11],[12,24],[24,25],[0,0]]},{"text":"כֵּן, בְּלִי בְּעָיָה.","ids":[1,1745,45,1918,3661,47,2],"offsets":[[0,0],[0,4],[4,5],[6,12],[13,21],[21,22],[0,0]]},{"text":"כַּמָּה זְמַן?","ids":[1,1711,1914,64,2],"offsets":[[0,0],[0,7],[8,13],[13,14],[0,0]]},{"text":"בְּעֵרֶךְ עֶשְׂרִים דַּקּוֹת.","ids":[1,5508,8505,2736,47,2],"offsets":[[0,0],[0,8],[10,19],[20,28],[28,29],[0,0]]},{"text":"הִגַּעְנוּ.","ids":[1,8394,47,2],"offsets":[[0,0],[0,9],[10,11],[0,0]]},{"text":"כַּמָּה אֲנִי חַיָּב?","ids":[1,1711,1482,13552,64,2],"offsets":[[0,0],[0,7],[8,13],[14,20],[20,21],[0,0]]},{"text":"מֵאָה שְׁקָלִים.","ids":[1,6745,3053,47,2],"offsets":[[0,0],[0,5],[6,15],[15,16],[0,0]]},{"text":"הִנֵּה, תּוֹדָה. יוֹם טוֹב!","ids":[1,2451,45,4558,47,1860,1741,34,2],"offsets":[[0,0],[0,6],[6,7],[8,15],[15,16],[17,21],[22,26],[26,27],[0,0]]},{"text":"שָׁלוֹם. יֵשׁ לִי הַזְמָנָה.","ids":[1,3387,47,1408,1444,11825,47,2],"offsets":[[0,0],[0,7],[7,8],[9,12],[14,17],[18,27],[27,28],[0,0]]},{"text":"בְּאֵיזֶה שֵׁם?","ids":[1,8063,1715,64,2],"offsets":[[0,0],[0,9],[10,14],[14,15],[0,0]]},{"text":"לֵוִי.","ids":[1,3753,47,2],"offsets":[[0,0],[0,5],[5,6],[0,0]]},{"text":"כֵּן, אֲנִי רוֹאֶה. שְׁלוֹשָׁה לֵילוֹת.","ids":[1,1745,45,1482,3155,47,2928,3823,47,2],"offsets":[[0,0],[0,4],[4,5],[6,11],[12,18],[18,19],[20,30],[31,38],[38,39],[0,0]]},{"text":"מָתַי אֲרוּחַת הַבֹּקֶר?","ids":[1,2599,6642,28041,64,2],"offsets":[[0,0],[0,5],[6,14],[15,23],[23,24],[0,0]]},{"text":"מִשֶּׁבַע עַד עֶשֶׂר.","ids":[1,50535,1536,4915,47,2],"offsets":[[0,0],[0,9],[10,13],[14,20],[20,21],[0,0]]},{"text":"הַחֶדֶר בַּקּוֹמָה הַשְּׁנִיָּה. הִנֵּה הַמַּפְתֵּחַ.","ids":[1,6111,12882,8139,47,2451,9028,47,2],"offsets":[[0,0],[0,7],[8,18],[19,31],[31,32],[33,39],[40,51],[52,53],[0,0]]},{"text":"תּוֹדָה רַבָּה!","ids":[1,4558,2910,34,2],"offsets":[[0,0],[0,7],[8,14],[14,15],[0,0]]},{"text":"Hello WORLD שלום","ids":[1,117766,24314,3387,2],"offsets":[[0,0],[0,5],[6,11],[12,16],[0,0]]}