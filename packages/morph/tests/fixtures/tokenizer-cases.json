,18561,16193,50410,47,2],"offsets":[[0,0],[0,3],[3,4],[5,8],[9,13],[14,19],[20,25],[26,31],[31,32],[0,0]]},{"text":"אני מקדישה יותר לשעות נוספות.","ids":[1,1482,58920,1459,19788,3445,47,2],"offsets":[[0,0],[0,3],[4,10],[11,15],[16,21],[22,28],[28,29],[0,0]]},{"text":"תום צריך למלא שליחות חשובה.","ids":[1,6579,1858,6574,15351,5456,47,2],"offsets":[[0,0],[0,3],[4,8],[9,13],[14,20],[21,26],[26,27],[0,0]]},{"text":"איך נקראת הציפור הזאת?","ids":[1,2083,13653,19320,2609,64,2],"offsets":[[0,0],[0,3],[4,9],[10,16],[17,21],[21,22],[0,0]]},{"text":"לתום היה לב רחום.","ids":[1,33794,1445,1415,58484,47,2],"offsets":[[0,0],[0,4],[5,8],[9,11],[12,16],[16,17],[0,0]]},{"text":"זה לילה לקראת יום לימודים.","ids":[1,1363,3077,3149,1860,7631,47,2],"offsets":[[0,0],[0,2],[3,7],[8,13],[14,17],[18,25],[25,26],[0,0]]},{"text":"קניתי לך מתנת פרידה קטנה.","ids":[1,21864,2089,27913,16566,3913,47,2],"offsets":[[0,0],[0,5],[6,8],[9,13],[14,19],[20,24],[24,25],[0,0]]},{"text":"על איזה סוג של לחם?","ids":[1,1303,3321,2351,1287,7171,64,2],"offsets":[[0,0],[0,2],[3,7],[8,11],[12,14],[15,18],[18,19],[0,0]]},{"text":"ישנו פארק נחמד במרכז העיר.","ids":[1,6630,7817,9508,3052,2075,47,2],"offsets":[[0,0],[0,4],[5,9],[10,14],[15,20],[21,25],[25,26],[0,0]]},{"text":"הילד לובש כפפות בחורף הקר.","ids":[1,3622,26943,28551,11384,1937,47,2],"offsets":[[0,0],[0,4],[5,9],[10,15],[16,21],[22,25],[25,26],[0,0]]},{"text":"יפנים אוכלים שלוש פעמים ביום.","ids":[1,48012,11639,2709,2941,2146,47,2],"offsets":[[0,0],[0,5],[6,12],[13,17],[18,23],[24,28],[28,29],[0,0]]},{"text":"אל תמשיך לתת בו אמון.","ids":[1,1426,12236,2695,1570,7088,47,2],"offsets":[[0,0],[0,2],[3,8],[9,12],[13,15],[16,20],[20,21],[0,0]]},{"text":"כבר אין לי טלפון נייד.","ids":[1,1679,1596,1444,6463,12504,47,2],"offsets":[[0,0],[0,3],[4,7],[8,10],[11,16],[17,21],[21,22],[0,0]]},{"text":"האנשים התקוממו נגד הפולשים.","ids":[1,3767,117904,2079,55560,47,2],"offsets":[[0,0],[0,6],[7,14],[15,18],[19,26],[26,27],[0,0]]},{"text":"קח לום ברזל.","ids":[1,18279,12